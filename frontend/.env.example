# Where the backend API runs. The Next.js server proxies /api and /uploads to it.
BACKEND_URL=http://localhost:5000

# Public base URL of THIS web app (used for page metadata / share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: same value as INTERNAL_API_KEY in the backend .env.
# Lets server-side rendering of public cards skip the per-IP rate limit.
INTERNAL_API_KEY=
