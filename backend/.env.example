# ───────── Server ─────────
PORT=5000
NODE_ENV=development
# Number of proxies in front of this API. The Next.js web app proxies /api requests, so keep 1
# (or 2 if there is also a load balancer such as Render/Nginx). Correct client IPs matter for
# rate limiting and unique-visitor counts. Do not expose the API directly to the internet with
# a value higher than the real number of proxies.
TRUST_PROXY=1

# Shared secret between the web app and this API (same value in frontend .env).
# Lets server-side rendering of public cards skip the per-IP rate limit. Generate a random string.
INTERNAL_API_KEY=
# Optional external job trigger secret (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ───────── Database ─────────
MONGO_URI=mongodb://127.0.0.1:27017/beno_digital_card

# ───────── Auth ─────────
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# A just-rotated refresh token may be replayed within this many seconds (parallel tabs, aborted
# page loads) without being treated as theft.
REFRESH_REUSE_GRACE_SECONDS=60

# ───────── URLs ─────────
# Where the Next.js app runs (used in emails, invite links, CORS)
FRONTEND_URL=http://localhost:3000
# Base used for public card links and QR codes (usually same as FRONTEND_URL or your card domain)
PUBLIC_CARD_BASE_URL=http://localhost:3000
# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=

# ───────── File storage ─────────
# local = files saved in UPLOAD_DIR on this server (needs a persistent disk in production)
# cloudinary = files uploaded to Cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beno-digital-card

# ───────── Email (Resend) ─────────
# Leave empty in development: emails are printed to the console instead of being sent
RESEND_API_KEY=
EMAIL_FROM=Beno Digital Card <no-reply@example.com>

# ───────── WhatsApp Business Cloud API (optional, platform default) ─────────
# Companies can also save their own WhatsApp credentials in Admin > Reminders (requires ENCRYPTION_KEY)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# 32-byte key (64 hex chars) used to encrypt stored third-party secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ───────── Background jobs ─────────
JOBS_ENABLED=true
DEFAULT_TIMEZONE=Asia/Kolkata
# One-time migration: set to "apply" for one deploy to sync old sample plan codes, then remove it.
SYNC_BUILTIN_PLANS=

# ───────── First Super Admin (created automatically on a new database, or by `npm run seed`) ─────────
SEED_SUPERADMIN_NAME=Beno Super Admin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
